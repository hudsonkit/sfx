{
  "name": "@hudsonkit/sfx",
  "version": "0.1.0",
  "type": "module",
  "description": "Conversation-first sound design for UI and product audio — describe one sound or a whole set, refine in chat, mix per layer. A Hudson app, a headless Web Audio engine, and an AI toolset.",
  "author": "Arach Tchoupani",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hudsonkit/sfx.git"
  },
  "homepage": "https://hudsonkit.com/sfx",
  "bugs": {
    "url": "https://github.com/hudsonkit/sfx/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "sound-design",
    "sfx",
    "ui-sounds",
    "web-audio",
    "audio",
    "synthesis",
    "foley",
    "react",
    "hudson",
    "hudsonkit",
    "ai",
    "agent"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js"
    },
    "./toolset": {
      "types": "./dist/toolset.d.ts",
      "import": "./dist/toolset.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsup && cp src/styles/sfx.css dist/styles.css",
    "dev": "tsup --watch --onSuccess 'cp src/styles/sfx.css dist/styles.css'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:dist": "publint",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build && bun run check:dist"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "peerDependencies": {
    "@hudsonkit/ai": "^0.2.2",
    "ai": "^7.0.6",
    "hudsonkit": "^0.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@hudsonkit/ai": { "optional": true },
    "ai": { "optional": true }
  },
  "devDependencies": {
    "@hudsonkit/ai": "^0.2.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "ai": "^7.0.6",
    "hudsonkit": "^0.3.4",
    "publint": "^0.3.21",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
